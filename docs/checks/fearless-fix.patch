+def _reset_series(match: str, tour: str, day: str) -> list[dict]:
+    """A Bo3 that is Fearless in games 1 and 2; game 3 resets and repeats game 1's picks."""
+    return [
+        game(f"{match}-1", match, tour, f"{day} 10:00", "25.S1.1", "ABCDE", "FGHIJ"),
+        game(f"{match}-2", match, tour, f"{day} 11:00", "25.S1.1", "KLNAB", "CDEFG") | FRESH,
+        game(f"{match}-3", match, tour, f"{day} 12:00", "25.S1.1", "ABCDE", "FGHIJ"),
+    ]
+
+
+def _soft_series(match: str, tour: str, day: str) -> list[dict]:
+    """Game 2 swaps the picks: each champion is picked twice, but never twice by the same team."""
+    return [
+        game(f"{match}-1", match, tour, f"{day} 10:00", "25.S1.1", "ABCDE", "FGHIJ"),
+        game(f"{match}-2", match, tour, f"{day} 11:00", "25.S1.1", "FGHIJ", "ABCDE"),
+    ]
+
+
+def test_reset_decider_and_soft_fearless():
+    rows = [r for i in range(3) for r in _reset_series(f"r{i}", "Reset Cup", f"2025-02-0{i + 1}")]
+    rows += [r for i in range(5) for r in _soft_series(f"s{i}", "Soft Cup", f"2025-03-0{i + 1}")]
+    rows += [r for i in range(2) for r in _soft_series(f"t{i}", "Small Soft Cup", f"2025-04-0{i + 1}")]
+    rows += [  # standard: T1 picks A in both games, so neither the hard nor the soft test passes
+        game("n1", "n", "Standard Cup", "2025-05-01 10:00", "25.S1.1", "ABCDE", "FGHIJ"),
+        game("n2", "n", "Standard Cup", "2025-05-01 11:00", "25.S1.1", "AKLNM", "FGHIJ"),
+    ]
+    g = pd.DataFrame(rows)
+    t = tournament_formats(g)
+    assert t.loc["Reset Cup", ["hard", "reset", "n_reset"]].tolist() == [0.0, 1.0, 3]
+    assert t.loc["Soft Cup", ["hard", "soft", "n_soft"]].tolist() == [0.0, 1.0, 5]
+    assert t["format"].to_dict() == {
+        "Reset Cup": "reset",
+        "Soft Cup": "soft",
+        "Small Soft Cup": "standard",  # fewer than 5 series, too few to trust the soft test
+        "Standard Cup": "standard",
+    }
+    flags = game_fearless(g).groupby(g["tournament"])
+    assert flags.nunique().eq(1).all()  # every game takes its tournament's flag
+    assert flags.first().to_dict() == {
+        "Reset Cup": True,
+        "Small Soft Cup": False,
+        "Soft Cup": True,
+        "Standard Cup": False,
+    }
