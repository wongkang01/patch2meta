-    max_repeat = long.groupby(["match_id", "picks"]).size().groupby(level="match_id").max()
+    """Hard test: 1.0 or 0.0 per multi-game series (match_id); series with one game are left out."""
+    m = _multi_game(games)
+    picks = pd.Series([list(b) + list(r) for b, r in zip(m["picks_blue"], m["picks_red"])], index=m.index)
+    long = pd.DataFrame({"match_id": m["match_id"], "pick": picks}).explode("pick")
+    max_repeat = long.groupby(["match_id", "pick"]).size().groupby(level="match_id").max()
     return (max_repeat <= 1).astype(float).rename("series_fearless")
 
 
+def series_reset(games: pd.DataFrame) -> pd.Series:
+    """Reset test: the hard test after removing each series' last game (series of 3+ games only)."""
+    order = games.sort_values(["match_id", "datetime_utc", "game_id"])
+    last = order.groupby("match_id")["game_id"].transform("last")
+    return series_fearless(order[order["game_id"] != last]).rename("series_reset")
+
+
+def series_soft(games: pd.DataFrame) -> pd.Series:
+    """Soft test: 1.0 when no team picks the same champion twice in the series."""
+    m = _multi_game(games)
+    sides = [
+        m[["match_id", f"team_{s}", f"picks_{s}"]].set_axis(["match_id", "team", "pick"], axis=1)
+        for s in ("blue", "red")
+    ]
+    long = pd.concat(sides).explode("pick")
+    max_repeat = long.groupby(["match_id", "team", "pick"]).size().groupby(level="match_id").max()
+    return (max_repeat <= 1).astype(float).rename("series_soft")
+
+
+def tournament_formats(games: pd.DataFrame) -> pd.DataFrame:
+    """Per tournament: share and number of series passing each test, and the resulting format.
+
+    `format` is "hard", "reset", "soft" (the first test that passes, in that order) or "standard".
+    """
+    tour_of = games.drop_duplicates("match_id").set_index("match_id")["tournament"]
+    cols = {}
+    for name, s in (
+        ("hard", series_fearless(games)),
+        ("reset", series_reset(games)),
+        ("soft", series_soft(games)),
+    ):
+        by_tour = s.groupby(tour_of.reindex(s.index))
+        cols[name] = by_tour.mean()
+        cols[f"n_{name}"] = by_tour.size()
+    t = pd.DataFrame(cols).reindex(tour_of.unique())
+    t[["n_hard", "n_reset", "n_soft"]] = t[["n_hard", "n_reset", "n_soft"]].fillna(0).astype(int)
+    passes = {
+        "hard": t["hard"].ge(THRESHOLD),
+        "reset": t["reset"].ge(THRESHOLD) & t["n_reset"].ge(MIN_RESET_SERIES),
+        "soft": t["soft"].ge(THRESHOLD) & t["n_soft"].ge(MIN_SOFT_SERIES),
+    }
+    t["format"] = "standard"
+    for name in ("soft", "reset", "hard"):  # reverse order so the first passing test wins
+        t.loc[passes[name], "format"] = name
+    return t
+
